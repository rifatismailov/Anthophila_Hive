/*
  Початкова перевірка на критичну інформацію (режим --critical).

  Правила працюють по НОРМАЛІЗОВАНОМУ тексту: нижній регістр, будь-які пробіли й
  переноси замінені одним пробілом. Тому фрази тут малими літерами, а закінчення
  слів задані регулярним виразом [^ ]{0,12}, щоб ловити відмінки
  ("службового користування", "службове користування").
  Збіг означає лише "передати на аналіз E5Search", вердикту YARA не виносить.
*/

rule crit_markings
{
    meta:
        description      = "Грифи та позначки обмеженого доступу"
        e5_tool          = "C:\\E5Search\\E5Search.exe"
        e5_chunk_size    = 700
        e5_chunk_overlap = 120

    strings:
        $m1 = /службов[^ ]{0,12} користуванн[^ ]{0,8}/
        $m2 = /обмежен[^ ]{0,12} доступ[^ ]{0,8}/
        $m3 = /державн[^ ]{0,12} таємни[^ ]{0,8}/

    condition:
        any of them
}

rule crit_domain_phrases
{
    meta:
        description      = "Типові словосполучення з переліку відомостей, що становлять службову інформацію"
        e5_tool          = "C:\\E5Search\\E5Search.exe"
        e5_chunk_size    = 700
        e5_chunk_overlap = 120

    strings:
        $d1 = /озброєнн[^ ]{0,8} та військов[^ ]{0,12} техні[^ ]{0,8}/
        $d2 = /бойов[^ ]{0,12} готовн[^ ]{0,8}/
        $d3 = /оперативн[^ ]{0,12} командуван[^ ]{0,8}/
        $d4 = /посадов[^ ]{0,12} осі[^ ]{0,8}/
        $d5 = /військово-облікови[^ ]{0,12} спеціальн[^ ]{0,12}/
        $d6 = /мобілізаційн[^ ]{0,12} (план|завдан|розгортан)[^ ]{0,8}/
        $d7 = /звітн[^ ]{0,12} період[^ ]{0,8}/
        $d8 = /захист[^ ]{0,12} інформаці[^ ]{0,8}/

        // Непрямі ознаки (без грифа і канонічних фраз) за формулюваннями ПСІ-2023.
        // Не додавати "координати", "орієнтир", "квадрат", "позивний": хибні спрацювання.
        // 4.1 розташування, чисельність
        $d9  = /дислокац/
        $d10 = /штатн[^ ]{0,8} чисельн/
        $d11 = /укомплектован/
        $d12 = /місц[^ ]{0,8} (розташуванн|дислокац|зосередженн)/
        // 5.1 поповнення, мобілізаційні ресурси
        $d13 = /військовозобов/
        $d14 = /доукомплектуванн/
        $d15 = /поповненн/
        $d16 = /(з|із) запасу/
        $d17 = /розгортанн/
        $d18 = /(офіцер|сержант|солдат)[^ ]{0,8} запасу/
        // 6.1 розвідка, противник
        $d19 = /розвідувальн/
        $d20 = /противник/
        $d21 = /протилежн[^ ]{0,8} сторон/
        $d22 = /спостереженн[^ ]{0,8} за/
        // 10.1, 10.3 озброєння, техніка, ремонт
        $d23 = /бронетанков/
        $d24 = /озброєнн/
        $d25 = /ремонтн[^ ]{0,8} підприємств/
        $d26 = /спеціальн[^ ]{0,8} техні/
        $d27 = /військов[^ ]{0,8} майн/

    condition:
        any of them
}
